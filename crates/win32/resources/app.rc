203 DIALOGEX 0, 0, 380, 145
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Download Status"
FONT 8, "Tahoma"
BEGIN
    CONTROL "Download pages", 2206, WC_TABCONTROL, WS_TABSTOP | WS_CLIPSIBLINGS, 10, 6, 360, 98
    CONTROL "", 2207, "Edit", ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP, 20, 24, 340, 10
    LTEXT "Status", 2214, 20, 35, 45, 9
    LTEXT "", 2208, 69, 35, 286, 9, SS_NOPREFIX
    LTEXT "File size", 2215, 20, 48, 66, 9
    LTEXT "", 2209, 92, 48, 263, 9, SS_NOPREFIX
    LTEXT "Downloaded", 2216, 20, 58, 66, 9
    LTEXT "", 2210, 92, 58, 263, 9, SS_NOPREFIX
    LTEXT "Transfer rate", 2217, 20, 68, 66, 9
    LTEXT "", 2211, 92, 68, 263, 9, SS_NOPREFIX
    LTEXT "Time left", 2218, 20, 78, 66, 9
    LTEXT "", 2212, 92, 78, 263, 9, SS_NOPREFIX
    LTEXT "Resume capability", 2219, 20, 88, 69, 9
    LTEXT "No", 2213, 92, 88, 263, 9
    CONTROL "Enable speed &limiter", 2223, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 29, 200, 12
    EDITTEXT 2224, 20, 49, 58, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "KB/sec", 2225, 84, 52, 40, 10
    PUSHBUTTON "&Apply", 2226, 134, 49, 50, 14, WS_TABSTOP
    LTEXT "Limit applies to this download. Uncheck and Apply for unlimited speed.", 2220, 20, 74, 330, 22
    LTEXT "This progress window closes automatically when the download completes.", 2221, 20, 30, 330, 22
    LTEXT "Completion notifications can be changed in Options > Downloads.", 2222, 20, 58, 330, 22
    CONTROL "Transfer progress", 2202, PROGRESS_CLASS, WS_BORDER | PBS_SMOOTH, 10, 110, 360, 10
    PUSHBUTTON "Show &details >>", 2204, 18, 126, 84, 14, WS_TABSTOP
    PUSHBUTTON "&Pause", 2205, 235, 126, 50, 14, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "&Cancel", 2203, 303, 126, 50, 14, WS_TABSTOP
    EDITTEXT 2201, 10, 152, 360, 70, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END

204 DIALOGEX 0, 0, 380, 185
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Retained Recovery Files"
