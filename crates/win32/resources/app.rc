    PUSHBUTTON "Open &folder", 2506, 148, 98, 62, 14, WS_TABSTOP
    PUSHBUTTON "&Close", IDCANCEL, 240, 98, 62, 14, WS_TABSTOP
    CONTROL "&Don't show this dialog again", 2507, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 117, 294, 10
END

202 DIALOGEX 0, 0, 330, 158
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
