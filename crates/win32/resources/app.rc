    EDITTEXT 2101, 58, 8, 226, 14, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Category", -1, 8, 33, 46, 9, SS_RIGHT
    COMBOBOX 2107, 58, 29, 106, 98, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
