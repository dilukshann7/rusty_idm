#include <windows.h>
#include <commctrl.h>

1 RT_MANIFEST "resources/app.manifest"
501 ICON "../../assets/branding/rusty.ico"

301 ICON "resources/icons/add.ico"
302 ICON "resources/icons/stop.ico"
303 ICON "resources/icons/stop_all.ico"
304 ICON "resources/icons/delete.ico"
305 ICON "resources/icons/options.ico"
306 ICON "resources/icons/add-disabled.ico"
307 ICON "resources/icons/stop-disabled.ico"
308 ICON "resources/icons/stop_all-disabled.ico"
309 ICON "resources/icons/delete-disabled.ico"
310 ICON "resources/icons/options-disabled.ico"

101 MENU
BEGIN
    POPUP "&Tasks"
    BEGIN
        MENUITEM "&Add URL...\tCtrl+N", 1001
        MENUITEM SEPARATOR
        MENUITEM "E&xit Rusty", 1009
    END
    POPUP "&File"
    BEGIN
        MENUITEM "&Open File", 1006
        MENUITEM "Open &Folder", 1007
        MENUITEM "&Delete Entry\tDel", 1004
    END
    POPUP "&Downloads"
    BEGIN
        MENUITEM "Start / &Resume Download", 1013
        MENUITEM "&Stop", 1002
        MENUITEM "Stop &All", 1003
        MENUITEM "&Retry from Beginning", 1005
        MENUITEM "Transfer &Details\tEnter", 1010
        MENUITEM SEPARATOR
        MENUITEM "&Options...", 1008
    END
    POPUP "&Queues"
    BEGIN
        MENUITEM "&Create queue...", 1026
        MENUITEM "&Rename selected queue...", 1027
        MENUITEM "&Delete empty queue", 1028
        MENUITEM SEPARATOR
        MENUITEM "&Start selected queue", 1029
        MENUITEM "S&top selected queue", 1030
        MENUITEM SEPARATOR
        MENUITEM "&One download at a time", 1031
        MENUITEM "T&wo downloads at a time", 1032
        MENUITEM "Move entry &up", 1033
        MENUITEM "Move entry &down", 1034
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&All Downloads", 1012
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Rusty", 1011
    END
END

102 ACCELERATORS
BEGIN
    "N", 1001, VIRTKEY, CONTROL
    VK_DELETE, 1004, VIRTKEY
    VK_RETURN, 1010, VIRTKEY
END

208 MENU
BEGIN
    POPUP "Download"
    BEGIN
        MENUITEM "&Open", 1006
        MENUITEM "Open &with...", 1014
        MENUITEM "Open &folder", 1007
        MENUITEM SEPARATOR
        MENUITEM "&Move/Rename (Ctrl-M)", 1015, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Redownload", 1016
        MENUITEM SEPARATOR
        MENUITEM "Res&ume Download", 1013
        MENUITEM "&Stop Download", 1002
        MENUITEM SEPARATOR
        MENUITEM "Refresh download &address", 1017, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Remo&ve", 1004
        MENUITEM SEPARATOR
        POPUP "Add to &queue"
        BEGIN
            MENUITEM "Main download queue", 1018
        END
        MENUITEM "Delete from queue", 1019
        MENUITEM SEPARATOR
        POPUP "On &Double click"
        BEGIN
            MENUITEM "Open", 1020
            MENUITEM "Open folder", 1021
            MENUITEM "Properties", 1022
        END
        MENUITEM SEPARATOR
        MENUITEM "Supply &credentials...", 1024
        MENUITEM "Confirm required restart...", 1025
        MENUITEM "Set category...", 1035
        MENUITEM "Move up in queue", 1033
        MENUITEM "Move down in queue", 1034
        MENUITEM "&Properties", 1010
    END
END

201 DIALOGEX 0, 0, 340, 58
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Enter New Address to Download"
FONT 8, "Tahoma"
BEGIN
    LTEXT "&Address", -1, 8, 10, 31, 9
    COMBOBOX 2101, 42, 7, 236, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 286, 7, 46, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 286, 26, 46, 14, WS_TABSTOP
    GROUPBOX "", -1, 8, 24, 270, 30
    CONTROL "Use &authorization", 2104, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 13, 23, 100, 10
    LTEXT "&Login", 2112, 46, 38, 27, 9, WS_DISABLED
    EDITTEXT 2105, 76, 35, 70, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_DISABLED
    LTEXT "&Password", 2113, 180, 38, 37, 9, WS_DISABLED
    EDITTEXT 2106, 220, 35, 50, 13, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP | WS_DISABLED
END

205 DIALOGEX 0, 0, 348, 146
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
