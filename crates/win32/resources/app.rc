    PUSHBUTTON "...", 2103, 274, 49, 16, 14, WS_TABSTOP
    CONTROL "", 2115, "Static", SS_ICON | SS_CENTERIMAGE, 307, 40, 24, 24
    GROUPBOX "", -1, 58, 68, 226, 33
    CONTROL "&Remember this path for this category", 2108, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 62, 66, 216, 11
    EDITTEXT 2111, 64, 84, 214, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Description", -1, 6, 112, 48, 9, SS_RIGHT
    EDITTEXT 2109, 58, 108, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Download &Later", 2110, 58, 130, 68, 14, WS_TABSTOP
    DEFPUSHBUTTON "&Start Download", IDOK, 136, 130, 68, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 214, 130, 70, 14, WS_TABSTOP
END

206 DIALOGEX 0, 0, 270, 165
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Duplicate download link"
FONT 8, "Tahoma"
BEGIN
    EDITTEXT 2401, 8, 8, 254, 14, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "This download link is already in the download list.", -1, 8, 30, 254, 10
    LTEXT "Please choose what you want to do:", -1, 8, 42, 254, 10
    CONTROL "Add the duplicate with a &numbered filename", 2402, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 60, 246, 12
    CONTROL "&Overwrite the existing download", 2403, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 12, 78, 246, 12
    CONTROL "If the existing download is &complete, show it;\notherwise, resume it", 2404, "Button", BS_AUTORADIOBUTTON | BS_MULTILINE | WS_TABSTOP, 12, 94, 246, 24
    DEFPUSHBUTTON "OK", IDOK, 151, 123, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 210, 123, 50, 14, WS_TABSTOP
    CONTROL "&Remember my selection (Options > Downloads)", 2405, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 146, 254, 11
END

207 DIALOGEX 0, 0, 310, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Download complete"
FONT 8, "Tahoma"
BEGIN
    CONTROL "", 2508, "Static", SS_ICON | SS_CENTERIMAGE, 8, 7, 20, 20
    LTEXT "Download complete", 2501, 34, 7, 268, 24, SS_NOPREFIX
    LTEXT "Address", -1, 8, 36, 294, 9
