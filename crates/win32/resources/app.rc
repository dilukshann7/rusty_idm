END

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Rusty Download Manager\0"
            VALUE "ProductName", "Rusty Download Manager\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "OriginalFilename", "rusty-win32.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

