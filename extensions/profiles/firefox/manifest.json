{
  "manifest_version": 3,
  "name": "Rusty Download Manager",
  "version": "0.2.1",
  "description": "Send public downloads and links to Rusty on Windows.",
  "incognito": "not_allowed",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "alarms",
    "webRequest",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rusty downloads"
  },
  "icons": {
    "16": "icons/rusty-16.png",
    "32": "icons/rusty-32.png",
    "48": "icons/rusty-48.png",
    "128": "icons/rusty-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rusty-download-manager@rusty.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
