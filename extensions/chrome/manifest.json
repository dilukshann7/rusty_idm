{
  "manifest_version": 3,
  "name": "Rusty Download Manager",
  "version": "0.1.0",
  "description": "Send public downloads and links to Rusty on Windows.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "alarms", "webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Rusty downloads" },
  "icons": { "16": "icons/rusty-16.png", "32": "icons/rusty-32.png", "48": "icons/rusty-48.png", "128": "icons/rusty-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
